{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/)(?!.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/notify-selection.js": {
      "maxDuration": 10
    }
  }
}
